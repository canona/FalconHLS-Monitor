# =====================================================================
# MẪU BIẾN MÔI TRƯỜNG - FalconHLS Monitor (StreamGuard HLS)
# - Chạy local: copy file này thành `.env` rồi điền giá trị thật.
# - Chạy trên Coolify: dán các dòng dưới vào tab "Environment Variables" của Application
#   (KHÔNG commit `.env` thật - xem HUONG-DAN-TRIEN-KHAI-COOLIFY.md).
# =====================================================================

# === Telegram Bot ===
# Token bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Chat ID nhận cảnh báo (user id, group id, hoặc channel id)
TELEGRAM_CHAT_ID=-1001234567890

# === Cấu hình ứng dụng ===
# Đường dẫn tới file config (mặc định: ./config.json - trong container là /app/config.json)
CONFIG_PATH=./config.json

# Mức log: error | warn | info | debug
LOG_LEVEL=info

# Cổng cho Web Dashboard + API + health-check (Coolify dùng để kiểm tra container còn sống)
PORT=3000

# === Basic Auth cho Web Dashboard (tùy chọn) ===
# Khai báo ĐỦ CẢ 2 biến để bật Basic Auth (thiếu 1 trong 2 sẽ KHÔNG bật auth).
# Nên bật khi dashboard public ra Internet qua domain Coolify.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=doi-mat-khau-nay

# Đường dẫn file diagnostic log riêng (thời gian chạy ffprobe, retry, phân loại lỗi...)
# Trên Coolify nên trỏ vào thư mục có mount volume (VD /app/logs/diagnostic.log) để không mất khi redeploy.
DIAGNOSTIC_LOG_PATH=./diagnostic.log

# Môi trường chạy
NODE_ENV=production

# === Đồng bộ danh sách luồng từ Partner API (Dynamic Source Sync) ===
# Danh sách đối tác + token, cách nhau dấu phẩy, mỗi cặp "ten_partner:token".
# Để trống nếu chỉ dùng staticStreams trong config.json (VD test bằng luồng Apple HLS).
# VTC_PARTNER_KEYS=vtvgo:token_cua_vtvgo,fpt:token_cua_fpt

# URL API trả về danh sách kênh - áp dụng CHUNG cho mọi Partner chưa khai báo riêng ở
# VTC_PARTNER_API_URLS bên dưới (tùy chọn - mặc định trỏ tới catchup.vtcrd.top)
# PARTNER_API_BASE_URL=https://catchup.vtcrd.top/api/public/channels

# URL API RIÊNG cho từng Partner (tùy chọn) - dùng khi 1 Partner có hạ tầng/domain khác hẳn, không
# chỉ khác token. Partner không có trong danh sách này sẽ dùng PARTNER_API_BASE_URL/mặc định chung.
# Tách theo dấu ":" ĐẦU TIÊN nên URL chứa "://" vẫn hợp lệ.
# VTC_PARTNER_API_URLS=vtvgo:https://catchup.vtcrd.top/api/public/channels,fpt:https://api.fpt.example/channels

# Chu kỳ đồng bộ lại danh sách kênh từ Partner API, đơn vị giây (tùy chọn - mặc định 300 = 5 phút)
# PARTNER_SYNC_INTERVAL_SECONDS=300

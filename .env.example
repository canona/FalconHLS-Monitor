# === Telegram Bot ===
# Token bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Chat ID nhận cảnh báo (user id, group id, hoặc channel id)
TELEGRAM_CHAT_ID=-1001234567890

# === Cấu hình ứng dụng ===
# Đường dẫn tới file config (mặc định: ./config.json)
CONFIG_PATH=./config.json

# Mức log: error | warn | info | debug
LOG_LEVEL=info

# Cổng cho HTTP health-check endpoint (Coolify dùng để kiểm tra container còn sống)
PORT=3000

# Môi trường chạy
NODE_ENV=production
